{"id": 3056, "tur": "mekruh", "kat": "acik", "karar": "TAMAM", "kesin": true, "kalip": null, "aciklama": "Başlık ile 1. maddeyi birleştiriyor ama hüküm (abdest bozarken kıbleye dönmek tahrîmen mekrûh) açık.", "kitap": null, "oneri": null}
{"id": 3057, "tur": "mekruh", "kat": "acik", "karar": "TAMAM", "kesin": true, "kalip": null, "aciklama": "Cümle mekrûhluğu açıkça bildiriyor.", "kitap": null, "oneri": null}
{"id": 3058, "tur": "mekruh", "kat": "acik", "karar": "Y", "kesin": false, "kalip": "BAGLAMSIZ", "aciklama": "\"bu cihetlere\" (kıble, Güneş, Ay) önceki maddede; sitede bağlam alanı veriyor, hafif.", "kitap": "3 — Küçük çocukları bu cihetlere karşı tutarak abdest etdirmek, tutan büyüğe mekrûh olur.", "oneri": "Önceki maddeyle ver."}
